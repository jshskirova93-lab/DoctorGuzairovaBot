from telegram import Update
from telegram.ext import (
    Application,
    CommandHandler,
    ConversationHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

from config import TOKEN
from keyboards import main_keyboard
from handlers import (
    menu,
    start_questionnaire,
    receive_name,
    receive_age,
    receive_height,
    receive_weight,
    receive_complaints,
    cancel_questionnaire,
    NAME,
    AGE,
    HEIGHT,
    WEIGHT,
    COMPLAINTS,
)


async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    """Команда /start."""

    context.user_data.clear()

    if update.message is None:
        return

    await update.message.reply_text(
        "Здравствуйте! 👋\n\n"
        "Я виртуальный помощник врача Гузаировой.\n\n"
        "Я помогу Вам:\n"
        "• познакомиться с врачом;\n"
        "• узнать стоимость консультаций;\n"
        "• подготовиться к консультации;\n"
        "• записаться на прием.\n\n"
        "Пожалуйста, выберите нужный раздел.",
        reply_markup=main_keyboard,
    )


async def show_my_id(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    """Показывает ID текущего Telegram-чата."""

    if update.effective_chat is None or update.message is None:
        return

    chat_id = update.effective_chat.id

    await update.message.reply_text(
        "🆔 Идентификатор этого Telegram-чата:\n\n"
        f"`{chat_id}`\n\n"
        "Сохраните этот номер. Он понадобится для отправки "
        "заявок администратору.",
        parse_mode="Markdown",
    )


def main():
    """Запуск Telegram-бота."""

    app = Application.builder().token(TOKEN).build()

    # Команда /start
    app.add_handler(
        CommandHandler(
            "start",
            start,
        )
    )

    # Команда для получения ID Telegram-чата
    app.add_handler(
        CommandHandler(
            "myid",
            show_my_id,
        )
    )

    # Интерактивная анкета пациента
    questionnaire_handler = ConversationHandler(
        entry_points=[
            MessageHandler(
                filters.Regex(r"^▶️ Продолжить$"),
                start_questionnaire,
            )
        ],
        states={
            NAME: [
                MessageHandler(
                    filters.TEXT & ~filters.COMMAND,
                    receive_name,
                )
            ],
            AGE: [
                MessageHandler(
                    filters.TEXT & ~filters.COMMAND,
                    receive_age,
                )
            ],
            HEIGHT: [
                MessageHandler(
                    filters.TEXT & ~filters.COMMAND,
                    receive_height,
                )
            ],
            WEIGHT: [
                MessageHandler(
                    filters.TEXT & ~filters.COMMAND,
                    receive_weight,
                )
            ],
            COMPLAINTS: [
                MessageHandler(
                    filters.TEXT & ~filters.COMMAND,
                    receive_complaints,
                )
            ],
        },
        fallbacks=[
            CommandHandler(
                "cancel",
                cancel_questionnaire,
            )
        ],
    )

    app.add_handler(questionnaire_handler)

    # Остальные кнопки и текстовые сообщения
    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            menu,
        )
    )

    print("===================================")
    print(" DoctorGuzairovaBot запущен")
    print(" Версия 1.2")
    print(" Анкета пациента подключена")
    print(" Команда /myid подключена")
    print("===================================")

    app.run_polling()


if __name__ == "__main__":
    main()